        </mxCell>
        <mxCell id="mint" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#CC6600;fontSize=12;" value="&lt;b&gt;mint_tokens.py&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;runs: python -m mcp_rest_lab.mint_tokens&lt;/font&gt;" vertex="1">

        <mxCell id="tokens" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="&lt;b&gt;tokens.json&lt;/b&gt;&lt;br/&gt;identity → JWT map&lt;br/&gt;&lt;font color=&#39;#666666&#39;&gt;student_001 … teacher_001&lt;/font&gt;" vertex="1">
